# ---------------------------------------------------------------- required
# Discord developer portal -> your application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Long random secret (>= 32 chars). Encrypts stored OAuth tokens and signs confirmations.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ENCRYPTION_KEY=

# Public URL of the dashboard. Add "<PUBLIC_URL>/api/auth/callback" as an OAuth2 redirect
# in the developer portal.
PUBLIC_URL=http://localhost:3000

# Local development with `npm run dev:db` (no Docker needed): use this exact value.
# With your own PostgreSQL 15+: postgres://user:password@localhost:5432/botcooks
# With docker compose: leave as-is; compose overrides it using POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# docker compose only
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- AI (Perplexity by default)
AI_PROVIDER=perplexity
AI_API_KEY=
# Optional: defaults to sonar-pro
# AI_MODEL=sonar-pro
# AI_TIMEOUT_MS=120000
# Max AI generations per user per hour (dashboard)
# AI_GENERATIONS_PER_HOUR=20

# ---------------------------------------------------------------- bot
# Privileged intents: ALSO enable them in the developer portal (Bot -> Privileged Gateway Intents)
# or the bot will fail to log in. Server Members: welcome, autoroles, anti-raid, member logs.
# Message Content: content auto-mod, message logs, message workflows.
BOT_INTENT_MEMBERS=false
BOT_INTENT_MESSAGE_CONTENT=false
# Your test server's ID: slash commands register there instantly (otherwise globally, which is slower).
# Discord: User Settings -> Advanced -> Developer Mode, then right-click the server icon -> Copy Server ID.
DEV_GUILD_ID=

# ---------------------------------------------------------------- integrations (worker)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# STREAM_POLL_SECONDS=120

LOG_LEVEL=info
